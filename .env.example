# ── 웹(apps/web) : Vite는 VITE_ 접두사만 브라우저에 노출한다 ──
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_xxx

# ── 워커(apps/worker) : 실제 값은 apps/worker/.dev.vars 와 `wrangler secret put` 으로 관리 ──
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# SUPABASE_JWT_SECRET=            # HS256 레거시 프로젝트만. 비우면 JWKS(ES256) 검증
# TURNSTILE_SECRET_KEY=0x4AAAAAAA_xxx
