# 자체 호스팅 서버 설정. 이 파일을 .env 로 복사해 채운다 (.env 는 커밋되지 않음)

# Postgres 접속. 집 PC 에 설치된 Postgres 를 그대로 쓴다.
DATABASE_URL=postgres://postgres:비밀번호@localhost:5432/goods_detail_maker

# 업로드 사진과 생성 결과를 저장할 폴더 (절대경로 권장, 용량 넉넉한 드라이브)
DATA_DIR=D:/GoodsDetailMaker/data

# OpenAI 키 암호화·세션 토큰용 비밀. 32자 이상 무작위 문자열. 바꾸면 저장된 키를 다시 넣어야 한다.
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
APP_SECRET=

# 포트
PORT=8787

# 웹 빌드 폴더 (기본값이면 그대로)
WEB_DIST=../web/dist

# 결과물 보관 일수. 0 = 무제한
JOB_RETENTION_DAYS=0

# 회원가입 허용 (첫 계정은 관리자). 가족·팀만 쓰면 가입 후 false 로
ALLOW_SIGNUP=true

# 소셜 로그인 리다이렉트의 기준 주소. 도메인·HTTPS 로 옮기면 이 값만 바꾸고,
# 제공자 콘솔에도 같은 콜백 주소를 등록한다.
PUBLIC_BASE_URL=http://localhost:8787

# 소셜 로그인. 채운 제공자만 로그인 화면에 버튼이 나온다 (비워 두면 그냥 꺼진다).
# 콜백 주소: <PUBLIC_BASE_URL>/api/auth/oauth/<google|kakao|naver>/callback
# 카카오는 client secret 사용이 선택이라 ID 만 채워도 된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

PLAN_MODEL=gpt-5-mini
IMAGE_MODEL=gpt-image-2
IMAGE_GENERATION_ENABLED=true
